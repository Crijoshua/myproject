<?xml version="1.0" encoding="utf-8"?>
<!-- macOS 风格控件层（M5b）：隐式 Button 模板 + 主按钮/卡片样式。
     取值一律 DynamicResource Macos*（ThemeController.Apply 热切 Light/Dark 字典，不重启）。
     挂载点：MainWindow.Resources（必须排在 ui:XamlControlsResources 之后——同层后合并者优先，
     隐式样式才能压过 ModernWpf 默认 Button；不得挂 Application 级，见 MainWindow.xaml 注释）。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 隐式 Button：macOS 次要按钮（浮起底 + 主文本色） ============ -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource MacosBackgroundElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MacosTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacosSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="{DynamicResource MacosFontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{DynamicResource MacosRadiusButton}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮：底色沉一档 + 轻微抬升阴影 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource MacosBackgroundBaseBrush}" />
                            <Setter TargetName="Root" Property="Effect"
                                    Value="{DynamicResource MacosCardHoverShadow}" />
                        </Trigger>
                        <!-- 按压：再深一档 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource MacosBackgroundSidebarBrush}" />
                            <Setter TargetName="Root" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 主按钮：macOS 系统蓝填充 / 白字（确认开工、派活、批准等关键动作用） ============ -->
    <Style x:Key="MacosAccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource MacosAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacosAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="{DynamicResource MacosRadiusButton}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource MacosAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource MacosAccentPressedBrush}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 卡片：任务卡 / 员工卡 / 审批条 / 预算区块通用（Elevated 底 + 圆角 + 柔和阴影） ============
         各页现有 Card/Panel/Section/Column 键沿用原键名，setter 值取同款 token；此样式供后续新卡片直取。 -->
    <Style x:Key="MacosCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MacosBackgroundElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacosSeparatorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource MacosRadiusCard}" />
        <Setter Property="Padding" Value="{DynamicResource MacosSpacingM}" />
        <Setter Property="Effect" Value="{DynamicResource MacosCardShadow}" />
    </Style>

</ResourceDictionary>
