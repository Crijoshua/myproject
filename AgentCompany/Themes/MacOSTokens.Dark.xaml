<?xml version="1.0" encoding="utf-8"?>
<!-- macOS 风格设计 Token —— 暗色(Dark)
     本字典为纯资源定义,M5a 阶段不接入 App/MainWindow;控件后续通过 DynamicResource 取键。
     与 MacOSTokens.Light.xaml 键名完全一致,仅取值不同(按 macOS 深色模式取值)。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================= 颜色与画刷(Color / SolidColorBrush 成对) ================= -->

    <!-- 主题强调色:按钮、链接、选中态(macOS 暗色系统蓝,更亮更饱和) -->
    <Color x:Key="MacosAccentColor">#FF0A84FF</Color>
    <SolidColorBrush x:Key="MacosAccentBrush" Color="{DynamicResource MacosAccentColor}" />

    <!-- 强调色按下态:按钮/可点元素按压时变亮一档(暗色模式按压提亮) -->
    <Color x:Key="MacosAccentPressedColor">#FF3395FF</Color>
    <SolidColorBrush x:Key="MacosAccentPressedBrush" Color="{DynamicResource MacosAccentPressedColor}" />

    <!-- 窗口/页面最底层基础背景色(近黑深灰) -->
    <Color x:Key="MacosBackgroundBaseColor">#FF1E1E20</Color>
    <SolidColorBrush x:Key="MacosBackgroundBaseBrush" Color="{DynamicResource MacosBackgroundBaseColor}" />

    <!-- 浮起表面背景色:卡片、弹窗、菜单等高于基础层的区域(深灰抬起面) -->
    <Color x:Key="MacosBackgroundElevatedColor">#FF2C2C2E</Color>
    <SolidColorBrush x:Key="MacosBackgroundElevatedBrush" Color="{DynamicResource MacosBackgroundElevatedColor}" />

    <!-- 侧边栏背景色:略亮于基础层以区分导航区 -->
    <Color x:Key="MacosBackgroundSidebarColor">#FF232326</Color>
    <SolidColorBrush x:Key="MacosBackgroundSidebarBrush" Color="{DynamicResource MacosBackgroundSidebarColor}" />

    <!-- 主文本色:标题、正文等主要文字(近白) -->
    <Color x:Key="MacosTextPrimaryColor">#FFF5F5F7</Color>
    <SolidColorBrush x:Key="MacosTextPrimaryBrush" Color="{DynamicResource MacosTextPrimaryColor}" />

    <!-- 次要文本色:辅助说明、副标题(中灰) -->
    <Color x:Key="MacosTextSecondaryColor">#FF98989E</Color>
    <SolidColorBrush x:Key="MacosTextSecondaryBrush" Color="{DynamicResource MacosTextSecondaryColor}" />

    <!-- 三级文本色:占位符、禁用态、时间戳等弱化信息(深灰) -->
    <Color x:Key="MacosTextTertiaryColor">#FF636366</Color>
    <SolidColorBrush x:Key="MacosTextTertiaryBrush" Color="{DynamicResource MacosTextTertiaryColor}" />

    <!-- 分隔线/描边色:列表分割线、卡片描边(暗色分隔线) -->
    <Color x:Key="MacosSeparatorColor">#FF38383D</Color>
    <SolidColorBrush x:Key="MacosSeparatorBrush" Color="{DynamicResource MacosSeparatorColor}" />

    <!-- 成功状态色:完成、在线、通过(macOS 暗色系统绿) -->
    <Color x:Key="MacosSuccessColor">#FF30D158</Color>
    <SolidColorBrush x:Key="MacosSuccessBrush" Color="{DynamicResource MacosSuccessColor}" />

    <!-- 警告状态色:待处理、提醒(macOS 暗色系统橙) -->
    <Color x:Key="MacosWarningColor">#FFFF9F0A</Color>
    <SolidColorBrush x:Key="MacosWarningBrush" Color="{DynamicResource MacosWarningColor}" />

    <!-- 危险状态色:删除、失败、错误(macOS 暗色系统红) -->
    <Color x:Key="MacosDangerColor">#FFFF453A</Color>
    <SolidColorBrush x:Key="MacosDangerBrush" Color="{DynamicResource MacosDangerColor}" />

    <!-- ================= 圆角(CornerRadius) ================= -->

    <!-- 卡片圆角:10px,macOS 卡片级圆角 -->
    <CornerRadius x:Key="MacosRadiusCard">10</CornerRadius>

    <!-- 按钮圆角:6px,按钮/输入框等小控件圆角 -->
    <CornerRadius x:Key="MacosRadiusButton">6</CornerRadius>

    <!-- 胶囊圆角:999(超大数据值强制全圆,用于标签、头像、开关) -->
    <CornerRadius x:Key="MacosRadiusPill">999</CornerRadius>

    <!-- ================= 阴影(DropShadowEffect,低强度、柔和) ================= -->

    <!-- 卡片默认阴影:柔和浅投影,方向朝下(暗色下不透明度略升以保证可见) -->
    <DropShadowEffect x:Key="MacosCardShadow" BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.14" Color="#000000" />

    <!-- 卡片悬浮阴影:鼠标悬停时略强,呈现浮起层次(暗色下不透明度略升) -->
    <DropShadowEffect x:Key="MacosCardHoverShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#000000" />

    <!-- ================= 间距(Thickness) ================= -->

    <!-- 小间距:8,紧凑内边距/元素间隙 -->
    <Thickness x:Key="MacosSpacingS">8</Thickness>

    <!-- 中间距:12,常规内边距 -->
    <Thickness x:Key="MacosSpacingM">12</Thickness>

    <!-- 大间距:16,卡片内边距/分组间距 -->
    <Thickness x:Key="MacosSpacingL">16</Thickness>

    <!-- 超大间距:24,页面区块间距 -->
    <Thickness x:Key="MacosSpacingXL">24</Thickness>

    <!-- ================= 字体与字号 ================= -->

    <!-- 全局字体族:优先 Segoe UI Variable Display,缺失时回退 Segoe UI / 微软雅黑 -->
    <FontFamily x:Key="MacosFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- 标题字号:20,页面/卡片标题 -->
    <sys:Double x:Key="MacosFontSizeTitle">20</sys:Double>

    <!-- 正文字号:14,默认正文文本 -->
    <sys:Double x:Key="MacosFontSizeBody">14</sys:Double>

    <!-- 辅助字号:12,说明文字、时间戳等小字 -->
    <sys:Double x:Key="MacosFontSizeCaption">12</sys:Double>

</ResourceDictionary>
