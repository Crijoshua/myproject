<UserControl x:Class="AgentCompany.Desktop.Pages.BudgetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:AgentCompany.Desktop.Pages">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource MacosRadiusCard}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Background" Value="{DynamicResource MacosBackgroundElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MacosSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{DynamicResource MacosCardShadow}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource MacosFontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource MacosTextPrimaryBrush}" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource MacosFontSizeCaption}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CellDim" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource MacosTextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="预算总览" FontSize="{DynamicResource MacosFontSizeTitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource MacosTextPrimaryBrush}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <!-- 轮 7：多任务实时预算（一行一条并行中任务 + 汇总行；crush 只计墙钟，token 记 0） -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="并行任务实时预算（多任务视图 · token / 墙钟独立记账，互不串账）" />
                        <ItemsControl x:Name="LiveList" AutomationProperties.AutomationId="LiveBudgetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:BudgetLiveRow}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Cell}" FontWeight="SemiBold"
                                                   Text="{Binding Head}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}"
                                                   AutomationProperties.AutomationId="LiveTokenText"
                                                   Text="{Binding TokenText}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CellDim}" Margin="14,0,0,0"
                                                   AutomationProperties.AutomationId="LiveWallText"
                                                   Text="{Binding WallText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="LiveSummary" Style="{StaticResource Cell}" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="LiveSummary" Margin="0,6,0,0" Text="" />
                        <TextBlock x:Name="LiveHint" Style="{StaticResource CellDim}" Text="当前没有并行任务"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 各任务三上限与剩余 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="各任务三上限与剩余（token / 墙钟 / 重跑）" />
                        <ItemsControl x:Name="TaskBudgetList" AutomationProperties.AutomationId="TaskBudgetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:BudgetTaskRow}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Text="{Binding Head}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}"
                                                   AutomationProperties.AutomationId="TaskTokenText"
                                                   Text="{Binding TokenText}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource CellDim}" Margin="14,0,0,0"
                                                   AutomationProperties.AutomationId="TaskWallText"
                                                   Text="{Binding WallText}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource CellDim}" Margin="14,0,0,0"
                                                   AutomationProperties.AutomationId="TaskRerunText"
                                                   Text="{Binding RerunText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TaskBudgetHint" Style="{StaticResource CellDim}" Text="还没有任务"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 任务×员工 token 矩阵（含 CEO） -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="任务 × 员工 token 矩阵（含 CEO 拆解调用）" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource CellDim}" Text="任务" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CellDim}" Text="claude" />
                            <TextBlock Grid.Column="2" Style="{StaticResource CellDim}" Text="opencode" />
                            <TextBlock Grid.Column="3" Style="{StaticResource CellDim}" MinWidth="110" Text="CEO（次数/token）" />
                            <TextBlock Grid.Column="4" Style="{StaticResource CellDim}" MinWidth="130" Text="crush（token 0·墙钟计量）" />
                            <TextBlock Grid.Column="5" Style="{StaticResource CellDim}" MinWidth="90" Text="合计" />
                        </Grid>
                        <ItemsControl x:Name="MatrixList" AutomationProperties.AutomationId="MatrixList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type pages:BudgetMatrixRow}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Head}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}"
                                                   AutomationProperties.AutomationId="MatrixClaude"
                                                   Text="{Binding ClaudeText}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Cell}"
                                                   AutomationProperties.AutomationId="MatrixOpencode"
                                                   Text="{Binding OpencodeText}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" MinWidth="110"
                                                   AutomationProperties.AutomationId="MatrixCeo"
                                                   Text="{Binding CeoText}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" MinWidth="130"
                                                   AutomationProperties.AutomationId="MatrixCrush"
                                                   Text="{Binding CrushText}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" MinWidth="90"
                                                   FontWeight="SemiBold" Text="{Binding TotalText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="MatrixHint" Style="{StaticResource CellDim}" Text="还没有 token 台账"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 熔断历史 -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="熔断历史（events type=budget）" />
                        <ItemsControl x:Name="FuseList" AutomationProperties.AutomationId="FuseList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Cell}" Margin="0,0,0,4"
                                               AutomationProperties.AutomationId="FuseRow"
                                               Foreground="{DynamicResource MacosDangerBrush}" Text="{Binding Line}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="FuseHint" Style="{StaticResource CellDim}" Text="暂无熔断记录"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
