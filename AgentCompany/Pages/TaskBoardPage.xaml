<UserControl x:Class="AgentCompany.Desktop.Pages.TaskBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:AgentCompany.Desktop.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Column" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource MacosRadiusCard}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource MacosBackgroundBaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MacosSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource MacosRadiusCard}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="{DynamicResource MacosBackgroundElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MacosSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{DynamicResource MacosCardShadow}" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource MacosFontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MacosTextPrimaryBrush}" />
        </Style>
        <Style x:Key="ColumnCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource MacosFontSizeCaption}" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource MacosTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource MacosFontSizeBody}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,20,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource MacosTextSecondaryBrush}" />
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource MacosFontSizeCaption}" />
        </Style>

        <!-- 步骤行：当前步骤高亮描边 + 加粗；DAG 节点行带所有权/依赖信息 + 节点级 [重跑]（③ 改提示词） -->
        <DataTemplate x:Key="StepRow" DataType="{x:Type pages:StepVm}">
            <Border x:Name="StepBorder" CornerRadius="4" Padding="6,3" Margin="0,0,0,4"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StepText" AutomationProperties.AutomationId="StepStatus"
                               FontSize="{DynamicResource MacosFontSizeCaption}" TextWrapping="Wrap" Text="{Binding Display}" />
                    <Button Grid.Column="1" Content="重跑" FontSize="{DynamicResource MacosFontSizeCaption}" Padding="6,1" Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="RerunNodeButton"
                            Visibility="{Binding CanRerunNode, Converter={StaticResource BoolToVis}}"
                            Click="OnRerunNodeClick" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="StepBorder" Property="BorderBrush" Value="{DynamicResource MacosAccentBrush}" />
                    <Setter TargetName="StepBorder" Property="Background" Value="#140078D7" />
                    <Setter TargetName="StepText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource MacosDangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource MacosSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 任务卡 -->
        <DataTemplate x:Key="TaskCard" DataType="{x:Type pages:TaskCardVm}">
            <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="TaskCard">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="CardTitle" FontSize="{DynamicResource MacosFontSizeBody}"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title}" />
                        <Border Grid.Column="1" CornerRadius="9" Padding="9,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#29808080" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="working">
                                            <Setter Property="Background" Value="#330078D7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="planning">
                                            <Setter Property="Background" Value="#330078D7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="preview">
                                            <Setter Property="Background" Value="#33B36B00" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="parse_failed">
                                            <Setter Property="Background" Value="#33C42B1C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="completed">
                                            <Setter Property="Background" Value="#29107C10" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="failed">
                                            <Setter Property="Background" Value="#33C42B1C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="cancelled">
                                            <Setter Property="Background" Value="#33807800" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="interrupted">
                                            <Setter Property="Background" Value="#33B36B00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource PillText}"
                                       AutomationProperties.AutomationId="CardStatus"
                                       Text="{Binding StatusText}" />
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepRow}" Margin="0,6,0,0" />

                    <!-- 轮 6：失败/拆解失败原因红标（预算超限等） -->
                    <TextBlock AutomationProperties.AutomationId="FailReasonText" FontSize="{DynamicResource MacosFontSizeCaption}" TextWrapping="Wrap"
                               Margin="0,4,0,0" Foreground="{DynamicResource MacosDangerBrush}" Text="{Binding FailReasonText}"
                               Visibility="{Binding HasFailReason, Converter={StaticResource BoolToVis}}" />

                    <!-- 轮 5：实时动作行 + 已耗时（仅运行中卡片可见；动作行滚动更新） -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                        <TextBlock AutomationProperties.AutomationId="CardElapsed" FontSize="{DynamicResource MacosFontSizeCaption}" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding ElapsedText}"
                                   Foreground="{DynamicResource MacosTextSecondaryBrush}" />
                        <TextBlock AutomationProperties.AutomationId="CardAction" FontSize="{DynamicResource MacosFontSizeCaption}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding LiveActionText}"
                                   Foreground="{DynamicResource MacosTextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock AutomationProperties.AutomationId="ArtifactsText"
                               FontSize="{DynamicResource MacosFontSizeCaption}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource MacosTextSecondaryBrush}"
                               Text="{Binding ArtifactsText}" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <!-- 轮 6：DAG 预览卡人工卡点——确认前绝不执行 -->
                        <Button Style="{DynamicResource MacosAccentButton}" Content="确认开工" MinWidth="88" Margin="0,0,8,0" Padding="8,3"
                                Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="ConfirmStartButton"
                                Click="OnConfirmStartClick" />
                        <Button Content="重新拆解" MinWidth="88" Margin="0,0,8,0" Padding="8,3"
                                Visibility="{Binding CanReplan, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="ReplanButton"
                                Click="OnReplanClick" />
                        <Button Content="终止整条流水线" MinWidth="104" Margin="0,0,8,0" Padding="8,3"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="CancelTaskButton"
                                Click="OnCancelTaskClick" />
                        <!-- 轮 5：一键恢复（人来点，不自动重试；新会话、非 resume 续接）。DAG 走节点级按钮 -->
                        <Button Content="重跑此步骤" MinWidth="88" Margin="0,0,8,0" Padding="8,3"
                                Visibility="{Binding CanRerunStep, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="RerunStepButton"
                                Click="OnRerunStepClick" />
                        <Button Content="整条重跑" MinWidth="88" Margin="0,0,8,0" Padding="8,3"
                                Visibility="{Binding CanRerun, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="RerunAllButton"
                                Click="OnRerunAllClick" />
                        <Button Content="打开产物文件夹" MinWidth="104" Padding="8,3"
                                Visibility="{Binding CanOpenArtifacts, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="OpenArtifactsButton"
                                Click="OnOpenArtifactsClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="任务看板" FontSize="{DynamicResource MacosFontSizeTitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource MacosTextPrimaryBrush}" />

        <!-- 新建流水线任务表单 -->
        <Border Grid.Row="1" Style="{StaticResource Column}" Margin="0,10,12,14" Padding="14">
            <StackPanel>
                <TextBlock FontSize="{DynamicResource MacosFontSizeBody}" FontWeight="SemiBold" Margin="0,0,0,6"
                           Foreground="{DynamicResource MacosTextPrimaryBrush}"
                           Text="新建流水线任务：步骤1（claude）→ 步骤2（opencode），串行接力、共享工作区；步骤留空即单步任务" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,10,6" FontSize="{DynamicResource MacosFontSizeBody}"
                             x:Name="NewTaskTitle" AutomationProperties.AutomationId="NewTaskTitle" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,6" FontSize="{DynamicResource MacosFontSizeBody}"
                             x:Name="NewTaskStep1" AutomationProperties.AutomationId="NewTaskStep1"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="72"
                             VerticalScrollBarVisibility="Auto" />
                    <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" MinWidth="110" VerticalAlignment="Stretch"
                            Style="{DynamicResource MacosAccentButton}"
                            Margin="0,0,0,6" Padding="10,4" Click="OnCreateClick"
                            x:Name="CreatePipelineButton" AutomationProperties.AutomationId="CreatePipelineButton" Content="新建流水线任务" />

                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Margin="0,0,10,0" FontSize="{DynamicResource MacosFontSizeCaption}"
                             x:Name="NewTaskStep2" AutomationProperties.AutomationId="NewTaskStep2"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="72"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="{DynamicResource MacosFontSizeCaption}" Opacity="0.55" TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MacosTextSecondaryBrush}"
                               Text="上：任务标题；右上：步骤 1 提示词（claude）；左下：步骤 2 提示词（opencode）。产物落在 workspace\pipeline\task-N\" />
                </Grid>

                <!-- 轮 6：项目任务——一句话需求交给 CEO 拆 DAG，人工确认后按波次执行 -->
                <TextBlock FontSize="{DynamicResource MacosFontSizeBody}" FontWeight="SemiBold" Margin="0,14,0,6"
                           Foreground="{DynamicResource MacosTextPrimaryBrush}"
                           Text="新建项目任务：一句话需求或 [选择计划] 导入 .md → CEO 拆任务 DAG（节点/员工/文件所有权/依赖）→ 人工 [确认开工] 后波次执行；三上限可改" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 需求框多行：一句话手输或 [选择计划] 读入 .md 计划全文均可（读入后可编辑） -->
                    <TextBox Grid.Column="0" Margin="0,0,10,0" FontSize="{DynamicResource MacosFontSizeBody}" MinHeight="58" MaxHeight="140"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             x:Name="ProjectDemand" AutomationProperties.AutomationId="ProjectDemand" />
                    <Button Grid.Column="1" MinWidth="92" Margin="0,0,8,0" Padding="10,4" VerticalAlignment="Bottom"
                            x:Name="PickPlanButton" AutomationProperties.AutomationId="PickPlanButton"
                            Content="选择计划" Click="OnPickPlanClick" />
                    <TextBox Grid.Column="2" Width="88" Margin="0,0,8,0" FontSize="{DynamicResource MacosFontSizeCaption}" Text="100000" VerticalAlignment="Bottom"
                             VerticalContentAlignment="Center" TextAlignment="Center"
                             x:Name="ProjBudgetTokens" AutomationProperties.AutomationId="ProjBudgetTokens" />
                    <TextBox Grid.Column="3" Width="64" Margin="0,0,8,0" FontSize="{DynamicResource MacosFontSizeCaption}" Text="30" VerticalAlignment="Bottom"
                             VerticalContentAlignment="Center" TextAlignment="Center"
                             x:Name="ProjBudgetWallMinutes" AutomationProperties.AutomationId="ProjBudgetWallMinutes" />
                    <TextBox Grid.Column="4" Width="44" Margin="0,0,8,0" FontSize="{DynamicResource MacosFontSizeCaption}" Text="3" VerticalAlignment="Bottom"
                             VerticalContentAlignment="Center" TextAlignment="Center"
                             x:Name="ProjBudgetReruns" AutomationProperties.AutomationId="ProjBudgetReruns" />
                    <Button Grid.Column="5" MinWidth="116" Padding="10,4" VerticalAlignment="Bottom"
                            Style="{DynamicResource MacosAccentButton}"
                            x:Name="SubmitProjectButton" AutomationProperties.AutomationId="SubmitProjectButton"
                            Content="提交 CEO 拆解" Click="OnSubmitProjectClick" />
                </Grid>
                <TextBlock FontSize="{DynamicResource MacosFontSizeCaption}" Opacity="0.55" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource MacosTextSecondaryBrush}"
                           Text="左：一句话需求，或 [选择计划] 读入 .md 计划全文（读入后可编辑再提交；任务标题取计划首个标题行）；三个数字依次为 token 上限 / 墙钟分钟 / 重跑次数上限（预算熔断，超限自动终止）。产物与公司记忆落在 workspace\pipeline\task-N\ 与 workspace\MEMORY.md" />
                <!-- 已读入的计划文件提示（读入成功才显示；提交后随表单一起清空） -->
                <TextBlock x:Name="PlanFileHint" FontSize="{DynamicResource MacosFontSizeCaption}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource MacosAccentBrush}" Text=""
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- 三列看板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Column}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="待办" />
                        <TextBlock Grid.Column="1" x:Name="TodoCount" Style="{StaticResource ColumnCount}" Text="0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="TodoList" AutomationProperties.AutomationId="TodoList"
                                          ItemTemplate="{StaticResource TaskCard}" />
                            <TextBlock x:Name="TodoHint" Style="{StaticResource EmptyHint}" Text="暂无任务" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Column}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="进行中" />
                        <TextBlock Grid.Column="1" x:Name="WorkingCount" Style="{StaticResource ColumnCount}" Text="0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="WorkingList" AutomationProperties.AutomationId="WorkingList"
                                          ItemTemplate="{StaticResource TaskCard}" />
                            <TextBlock x:Name="WorkingHint" Style="{StaticResource EmptyHint}" Text="暂无任务" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Column}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="已完成" />
                        <TextBlock Grid.Column="1" x:Name="DoneCount" Style="{StaticResource ColumnCount}" Text="0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="DoneList" AutomationProperties.AutomationId="DoneList"
                                          ItemTemplate="{StaticResource TaskCard}" />
                            <TextBlock x:Name="DoneHint" Style="{StaticResource EmptyHint}" Text="暂无任务" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
